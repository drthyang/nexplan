{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scatterplan-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5187", "--strictPort"],
      "port": 5187,
      "url": "http://localhost:5187"
    },
    {
      "name": "scatterplan-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build && npx vite preview --port 4187 --strictPort"],
      "port": 4187,
      "url": "http://localhost:4187"
    }
  ]
}
